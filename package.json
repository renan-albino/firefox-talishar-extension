{
  "name": "firefox-talishar",
  "version": "0.1.0",
  "description": "Firefox WebExtension to capture Talishar.net match logs and export to local PT-BR CSV and Google Sheets",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt -b firefox",
    "build": "wxt build -b firefox",
    "zip": "wxt zip -b firefox",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "happy-dom": "^20.14.3",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "wxt": "^0.19.0"
  }
}
